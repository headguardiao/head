# Copy to .env (gitignored) and fill in. Never commit real values.

# SQLite file path for forge/accounts (private exchange connections).
FORGE_DB_PATH=forge_accounts.db

# Symmetric key used to encrypt stored exchange API secrets at rest.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes every stored connection undecryptable - back it
# up in a secret manager, not in this repo.
FORGE_ENCRYPTION_KEY=

# Bearer token required on every endpoint except /health and /signal/*.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty/unset for local-only use with auth disabled (see forge/auth.py) -
# but it MUST be set before this server is reachable from anywhere else.
# Callers send it as: Authorization: Bearer <value>
FORGE_API_KEY=
