# Copy to .env (gitignored) and fill in. Never commit real values.

# SQLite file path for forge/accounts (private exchange connections).
FORGE_DB_PATH=forge_accounts.db

# Symmetric key used to encrypt stored exchange API secrets at rest.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes every stored connection undecryptable - back it
# up in a secret manager, not in this repo.
FORGE_ENCRYPTION_KEY=
